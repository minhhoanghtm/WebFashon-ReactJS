# ==============================================================================
# REACT-WebFashion — Background Worker Production Multi-Stage Dockerfile
# Executes BullMQ workers (email, tracking, vector sync) with dumb-init
# ==============================================================================

# ---------- Stage 1: Dependencies ----------
FROM node:22-alpine AS deps
WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund || npm install --omit=dev --no-audit --no-fund

# ---------- Stage 2: Production Worker Runtime ----------
FROM node:22-alpine AS runner
WORKDIR /app

# Install dumb-init for proper signal handling (SIGTERM graceful worker shutdown)
RUN apk add --no-cache dumb-init

ENV NODE_ENV=production

# Copy node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json

# Copy application code
COPY . .

# Set permissions for non-root node user
RUN chown -R node:node /app

USER node

# dumb-init forwards signals to worker.js which drains BullMQ active jobs
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "src/worker.js"]
