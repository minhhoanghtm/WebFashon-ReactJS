# ==============================================================================
# REACT-WebFashion — 404 Studio: STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

PORT=5000
NODE_ENV=staging
CLIENT_URL=http://localhost:8088
FRONTEND_URL=http://localhost:8088

# Isolated Staging Database (Strictly separated from Production)
MONGO_CONNECTIONSTRING=mongodb://staging_admin:staging_secret@mongo-staging:27017/webfashion_staging?authSource=admin
REDIS_URL=redis://redis-staging:6379
REDIS_HOST=redis-staging
REDIS_PORT=6379

# Authentication & Security
JWT_SECRET=staging_jwt_secret_key_change_in_cloud_vault_2026
REFRESH_TOKEN_SECRET=staging_refresh_secret_key_change_in_cloud_vault_2026
SESSION_SECRET=staging_session_secret_change_in_cloud_vault_2026

# Vector AI & Embedding Settings
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
VECTOR_SEARCH_ENGINE=mongo_cosine
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY_OR_VAULT_REFERENCE

# A/A & Recommendation Experimentation Framework
ACTIVE_REC_EXPERIMENT_ID=AA_Recommendation_Validation
EXPERIMENT_KILL_SWITCH_ENABLED=false
DEFAULT_REC_ALGORITHM=control_popular
EXPERIMENT_ATTRIBUTION_WINDOW_HOURS=24
EXPERIMENT_STICKY_CACHE_TTL_DAYS=30

# Rate Limiting & Queue Tuning
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
TRACKING_BATCH_SIZE=25
TRACKING_QUEUE_CONCURRENCY=5
