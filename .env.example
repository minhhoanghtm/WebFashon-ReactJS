# .env.example — Template biến môi trường production
# Sao chép thành back-end/.env.production trên VPS rồi điền giá trị thật
# KHÔNG commit file .env.production lên git

# ── Server ──────────────────────────────────────────────────────
DOMAIN=yourdomain.com
PORT=5000
NODE_ENV=production
BASE_URL=https://yourdomain.com

# ── MongoDB ─────────────────────────────────────────────────────
# Dùng MongoDB trong Docker (khuyên dùng trên VPS)
MONGO_USER=admin
MONGO_PASS=change_this_strong_password
MONGO_CONNECTIONSTRING=mongodb://admin:change_this_strong_password@mongo:27017/webfashion?authSource=admin

# Hoặc MongoDB Atlas (bỏ comment nếu dùng Atlas)
# MONGO_CONNECTIONSTRING=mongodb+srv://user:pass@cluster.mongodb.net/webfashion

# ── Redis ────────────────────────────────────────────────────────
# Khi chạy trong Docker Compose, tên service là "redis"
REDIS_URL=redis://redis:6379

# ── JWT ──────────────────────────────────────────────────────────
# Tạo bằng lệnh: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=replace_with_64_byte_hex_string
REFRESH_TOKEN_SECRET=replace_with_64_byte_hex_string

# ── CORS ─────────────────────────────────────────────────────────
CLIENT_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ── Email (Gmail App Password) ───────────────────────────────────
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx

# ── Google OAuth ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── MoMo Payment ─────────────────────────────────────────────────
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://yourdomain.com/api/payments/momo/return
MOMO_IPN_URL=https://yourdomain.com/api/payments/momo/ipn
MOMO_LANG=vi

# ── VNPay Payment ─────────────────────────────────────────────────
VNP_TMNCODE=your_vnp_tmncode
VNP_HASHSECRET=your_vnp_hashsecret
VNP_URL=https://pay.vnpay.vn/vpcpay.html
VNP_RETURNURL=https://yourdomain.com/api/payments/vnpay/return
VNP_IPN_URL=https://yourdomain.com/api/payments/vnpay/ipn
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_CURRCODE=VND
VNPAY_LOCALE=vn
VNPAY_ORDERTYPE=fashion

# ── GHN Shipping ──────────────────────────────────────────────────
GHN_TOKEN=your_ghn_token
GHN_SHOP_ID=your_shop_id
GHN_BASE_URL=https://online-gateway.ghn.vn/shiip/public-api
DEFAULT_SHIPPING_FEE=30000

# ── AI (OpenRouter) ───────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key
