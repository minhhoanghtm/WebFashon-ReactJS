# ==============================================================================
# REACT-WebFashion — Production Environment Configuration (.env.production.example)
# Sao chép thành .env.production trên máy chủ triển khai và thiết lập giá trị bảo mật
# TUYỆT ĐỐI KHÔNG commit file .env.production hoặc secrets thật lên kho mã nguồn!
# ==============================================================================

# ── Tên miền & Thiết lập máy chủ ──────────────────────────────────────────────
DOMAIN=atelier-archive.vn
NODE_ENV=production
APP_ENV=production
PORT=5000
BASE_URL=https://atelier-archive.vn
FRONTEND_URL=https://atelier-archive.vn
CLIENT_URL=https://atelier-archive.vn

# ── Cơ sở dữ liệu MongoDB ────────────────────────────────────────────────────
# Tùy chọn 1: MongoDB Cluster Atlas (Khuyến nghị cho Production)
# MONGO_CONNECTIONSTRING=mongodb+srv://<prod-user>:<prod-password>@cluster0.dpfy7rs.mongodb.net/webfashion_prod?retryWrites=true&w=majority&appName=webfashion
# Tùy chọn 2: MongoDB Docker nội bộ (nếu tự host)
MONGO_USER=webfashion_prod_admin
MONGO_PASS=replace_with_strong_password_minimum_24_chars
MONGO_CONNECTIONSTRING=mongodb://webfashion_prod_admin:replace_with_strong_password_minimum_24_chars@mongo:27017/webfashion?authSource=admin

# ── Bộ nhớ đệm & Hàng đợi Redis ──────────────────────────────────────────────
# Khi chạy qua docker-compose.production.yml, tên host là "redis"
REDIS_URL=redis://:replace_with_strong_redis_password@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password

# ── Khóa bí mật JWT & Bảo mật (Tối thiểu 64 hex characters) ──────────────────
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=replace_with_strong_random_64_byte_hex_secret
REFRESH_TOKEN_SECRET=replace_with_strong_random_64_byte_hex_secret
ACTION_SECRET=replace_with_strong_random_64_byte_hex_secret
OTP_SECRET=replace_with_strong_random_64_byte_hex_secret

# ── Email Gửi Mã OTP (Google Gmail Workspace / SES) ──────────────────────────
EMAIL_USER=support@atelier-archive.vn
EMAIL_PASS=replace_with_google_app_specific_password

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_production_google_client_id.apps.googleusercontent.com

# ── AI Shopping Assistant (OpenRouter Production API) ────────────────────────
OPENROUTER_API_KEY=sk-or-v1-replace_with_production_openrouter_api_key

# ── Đối tác Vận chuyển GHN (Production Gateway) ──────────────────────────────
GHN_TOKEN=replace_with_production_ghn_token
GHN_SHOP_ID=replace_with_production_ghn_shop_id
GHN_BASE_URL=https://online-gateway.ghn.vn/shiip/public-api
DEFAULT_SHIPPING_FEE=30000

# ── Cổng thanh toán MoMo (Môi trường Live Production) ─────────────────────────
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=replace_with_production_momo_access_key
MOMO_SECRET_KEY=replace_with_production_momo_secret_key
MOMO_ENDPOINT=https://payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://atelier-archive.vn/api/payments/momo/return
MOMO_IPN_URL=https://atelier-archive.vn/api/payments/momo/ipn
MOMO_LANG=vi

# ── Cổng thanh toán VNPay (Môi trường Live Production) ────────────────────────
VNP_TMNCODE=replace_with_production_vnpay_tmncode
VNP_HASHSECRET=replace_with_production_vnpay_hashsecret
VNP_URL=https://pay.vnpay.vn/vpcpay.html
VNP_RETURNURL=https://atelier-archive.vn/api/payments/vnpay/return
VNP_IPN_URL=https://atelier-archive.vn/api/payments/vnpay/ipn
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_CURRCODE=VND
VNPAY_LOCALE=vn
VNPAY_ORDERTYPE=fashion
