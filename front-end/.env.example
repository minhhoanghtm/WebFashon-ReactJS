# ==============================================================================
# REACT-WebFashion — Front-end Environment Variables Template
# ==============================================================================

# Local Vite Dev Server Port
PORT=5173

# Backend API Base URL (accessed by the user's browser)
# For local dev without Nginx: http://localhost:5000/api
# For local Docker Compose / Staging: http://localhost:8081/api
# For Production: https://yourdomain.com/api
VITE_API_URL=http://localhost:5000/api

# Google OAuth Client ID for Single Sign-On
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

